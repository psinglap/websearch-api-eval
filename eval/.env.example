# Copy to .env and fill in. Never commit .env.
# Required: the six search-provider keys below (+ SEC_USER_AGENT for ./run.sh keys).
YDC_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
LINKUP_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email:
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name you@example.com"
# Optional: GitHub token raises the search API limit from 10/min to 30/min
GITHUB_TOKEN=
# Optional: Internet Archive S3-style keys enable the authenticated SPN2 API
# (https://archive.org/account/s3.php). Without them, anonymous Save Page Now is used.
IA_ACCESS_KEY=
IA_SECRET_KEY=
# Optional overrides (defaults live in config/settings.yaml)
# WARMUP_MODE=search   # search | connect | off
# --- Optional, NOT needed by default (answer_mode: offline makes no LLM API calls) ---
# Only for ANSWER_MODE=api (legacy: Claude answers + LLM graders inside promptfoo):
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=claude-opus-5-5
# GRADER_MODEL=claude-opus-5-5
# Only for the optional ./run.sh crosscheck (vendor harnesses use OpenAI models):
# OPENAI_API_KEY=
