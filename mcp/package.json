{
  "name": "websearch-api-eval-mcp",
  "version": "1.1.0",
  "description": "MCP server for the Web Search API Eval benchmark (You.com, Tavily, Exa, Parallel): results, charts, methodology, and live search tests with your own keys.",
  "mcpName": "io.github.psinglap/websearch-api-eval",
  "license": "MIT",
  "author": "Pallavi Singla",
  "homepage": "https://psinglap.github.io/websearch-api-eval/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psinglap/websearch-api-eval.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/psinglap/websearch-api-eval/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "web-search",
    "search-api",
    "benchmark",
    "evaluation",
    "llm",
    "ai-agents",
    "rag",
    "you.com",
    "tavily",
    "exa",
    "parallel",
    "claude"
  ],
  "type": "module",
  "bin": {
    "websearch-api-eval-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "esbuild": "0.28.2"
  }
}
