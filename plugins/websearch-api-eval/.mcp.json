{
  "mcpServers": {
    "websearch-api-eval": {
      "command": "npx",
      "args": ["-y", "websearch-api-eval-mcp@1.1.0"],
      "env": {
        "YDC_API_KEY": "${YDC_API_KEY:-}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY:-}",
        "EXA_API_KEY": "${EXA_API_KEY:-}",
        "PARALLEL_API_KEY": "${PARALLEL_API_KEY:-}"
      }
    }
  }
}
